<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_default_title"
            android:textColor="@color/unsplice_ivory"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_default_subtitle"
            android:textColor="@color/unsplice_slate"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_rewind"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_button"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/widget_rewind"
            android:textAllCaps="false"
            android:textColor="@color/unsplice_ivory"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_play_pause"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.2"
            android:background="@drawable/widget_primary_button"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="@string/widget_play"
            android:textAllCaps="false"
            android:textColor="@color/unsplice_on_mint"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_forward"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_button"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/widget_forward"
            android:textAllCaps="false"
            android:textColor="@color/unsplice_ivory"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widget_skip_ad"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1.2"
            android:background="@drawable/widget_amber_button"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/widget_skip_ad"
            android:textAllCaps="false"
            android:textColor="@color/unsplice_amber"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
